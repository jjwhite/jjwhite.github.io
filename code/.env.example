# Environment configuration for POSSE syndication
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env

# Site URL (canonical domain where notes are hosted)
SITE_URL=https://jonwhite.me

# Mastodon Configuration
# Example: instance is mastodon.world (without https://)
MASTODON_INSTANCE=mastodon.world
# Generate an access token from Mastodon -> Preferences -> Development -> New Application
MASTODON_ACCESS_TOKEN=your_mastodon_access_token_here

# Bluesky Configuration
# Your handle, e.g. jjwhite01.bsky.social
BLUESKY_HANDLE=jjwhite01.bsky.social
# Generate an App Password in Bluesky -> Settings -> Privacy and Security -> App Passwords
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
